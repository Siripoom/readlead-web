# Server-only URL of the ReadLead backoffice service.
BACKOFFICE_API_URL=http://localhost:3001

# Firebase Web app configuration (public identifiers embedded in the client bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Omise public key for client-side card/Apple Pay tokenization (omise.js).
# Use pkey_test_... in development, pkey_live_... in production.
NEXT_PUBLIC_OMISE_PUBLIC_KEY=

# Google Pay & Wallet Console Merchant ID (pay.google.com/business/console).
# Optional in TEST but required once NEXT_PUBLIC_OMISE_PUBLIC_KEY is a
# pkey_live_... key (see GOOGLE_PAY_ENVIRONMENT in GatewayChargeDialog.tsx).
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=

# Apple merchant identifier, e.g. merchant.co.th.readlead. Apple Pay has no
# test mode: it additionally needs the domain registered with Omise and the
# association file served at
# /.well-known/apple-developer-merchantid-domain-association over HTTPS.
# The certificate half lives in readlead-backoffice (APPLE_PAY_MERCHANT_CERT).
NEXT_PUBLIC_APPLE_PAY_MERCHANT_ID=
